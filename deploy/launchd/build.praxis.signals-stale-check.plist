<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. __BIN_DIR__ (the INTERNAL-disk runtime dir
     ~/Library/Application Support/Praxis/bin) is substituted by
     scripts/praxis-signals-install.sh at install/deploy time. The script MUST run from
     internal disk: macOS TCC blocks launchd from executing scripts on the external
     volume /Volumes/Sensidine ("Operation not permitted"). Installed copy lives at
     ~/Library/LaunchAgents/build.praxis.signals-stale-check.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>build.praxis.signals-stale-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__BIN_DIR__/praxis-signals-stale-check.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/admin/praxis-signals/logs/signals-stale-check.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/admin/praxis-signals/logs/signals-stale-check.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>

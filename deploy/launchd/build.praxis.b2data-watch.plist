<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. __BIN_DIR__ (the INTERNAL-disk runtime dir
     ~/Library/Application Support/Praxis/bin) and __MAILBOX_ROOT__ (the mailbox
     root under the Parallels share, ~/praxis-signals/b2-data) are substituted by
     scripts/praxis-b2data-watch-install.sh at install/deploy time. The script
     MUST run from internal disk: macOS TCC blocks launchd from executing scripts
     on the external volume /Volumes/Sensidine ("Operation not permitted").
     Installed copy lives at ~/Library/LaunchAgents/build.praxis.b2data-watch.plist

     Praxis_build-3q4 (b2-data-mailbox): a NEW, INDEPENDENT KeepAlive daemon —
     it does NOT touch the live signal-path daemons (build.praxis.signals-*).
     The daemon loops its own 15s sweep (no WatchPaths/StartInterval); KeepAlive
     restarts it on any death. Data landing is not latency-sensitive. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>build.praxis.b2data-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__BIN_DIR__/praxis-b2data-watch.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/admin/praxis-signals/logs/b2data-watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/admin/praxis-signals/logs/b2data-watch.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PRAXIS_B2DATA_ROOT</key>
    <string>__MAILBOX_ROOT__</string>
  </dict>
</dict>
</plist>

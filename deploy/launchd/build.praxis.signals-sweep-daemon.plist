<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. __BIN_DIR__ (the INTERNAL-disk runtime dir
     ~/Library/Application Support/Praxis/bin) is substituted by
     scripts/praxis-signals-install.sh at install/deploy time. The script MUST run
     from internal disk: macOS TCC blocks launchd from executing scripts on the
     external volume /Volumes/Sensidine ("Operation not permitted"). Installed copy
     lives at ~/Library/LaunchAgents/build.praxis.signals-sweep-daemon.plist

     8xf (D-2026-07-12-A): persistent KeepAlive daemon REPLACES the WatchPaths
     trigger of build.praxis.signals-sweep — launchd's 10s minimum-runtime throttle
     delayed WatchPaths respawns under signal bursts (measured up to 9.15s vs the
     <5s budget; docs/reports/2026-07-12-8xf-latency-investigation.md). No
     WatchPaths / StartInterval here: the daemon loops the sweep itself every 1s.
     KeepAlive restarts it on any death; the ~1s-fresh heartbeat + existing
     stale-check catch hangs. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>build.praxis.signals-sweep-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__BIN_DIR__/praxis-signals-sweep-daemon.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/admin/praxis-signals/logs/signals-sweep-daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/admin/praxis-signals/logs/signals-sweep-daemon.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
